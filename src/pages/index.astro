---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.tsx";
import ScrollCanvas from "../components/ScrollCanvas.astro";
import HorizontalShowcase from "../components/HorizontalShowcase.tsx";
import ProblemSolution from "../components/sections/ProblemSolution.astro";
import Pillars from "../components/sections/Pillars.astro";
import AgentsShowcase from "../components/sections/AgentsShowcase.astro";
import ObjectionsProof from "../components/sections/ObjectionsProof.astro";
import FinalCTA from "../components/sections/FinalCTA.astro";
import { modules } from "../data/modules";

const showcaseItems = modules.map((m) => ({
  number: m.number,
  title: m.title,
  tagline: m.tagline,
  summary: m.summary,
  price: m.price,
  image: `/assets/modules/${m.slug}.jpg`,
  href: `/leistungen/${m.slug}`,
}));
---

<Layout
  title="Ihre KI-Marketingabteilung"
  description="ROCK IT UP Media baut autarke, maßgeschneiderte KI-Marketinginfrastrukturen direkt in Ihrem Unternehmen — 1 Senior Strategist, 162 AI-Agents, EU-vServer, DSGVO-konform."
>
  <ScrollCanvas heightVh={260}>
    <Hero client:load />
  </ScrollCanvas>
  <ProblemSolution />
  <Pillars />
  <HorizontalShowcase items={showcaseItems} client:visible />
  <AgentsShowcase />
  <ObjectionsProof />
  <FinalCTA />
</Layout>
