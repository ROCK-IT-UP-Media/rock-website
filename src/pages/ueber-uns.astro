---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/ui/Icon.astro";
import { leadershipAgents, totalAgentCount, microSpecialistCount } from "../data/agents";

const colorMap: Record<string, string> = {
  miami: "bg-miami/12 text-miami-dark border-miami/20",
  coral: "bg-coral/10 text-coral-dark border-coral/20",
  cyan: "bg-cyan/10 text-slate border-cyan/25",
  slate: "bg-slate/6 text-slate border-slate/15",
};
---

<Layout
  title="Über Uns"
  description="Der Gründer von ROCK IT UP Media, seine jahrzehntelange Marketing-Expertise und das intern gespiegelte New Yorker Agentur-Team aus 162 AI-Agents."
>
  <section class="relative overflow-hidden bg-white pb-16 pt-20">
    <div class="glow-orb -right-32 top-0 h-96 w-96 bg-miami/20"></div>
    <div class="container-rock relative mx-auto max-w-3xl text-center">
      <span class="section-eyebrow">Über Uns</span>
      <h1 class="mt-6 font-display text-4xl font-bold leading-tight text-slate md:text-5xl">
        Vom digitalen Nomaden zum KI-Systemintegrator
      </h1>
    </div>
  </section>

  <section class="pb-24">
    <div class="container-rock">
      <div class="mx-auto grid max-w-4xl gap-16">
        <div>
          <span class="badge">Founder-DNA</span>
          <h2 class="mt-4 font-display text-2xl font-bold text-slate md:text-3xl">Die Global-Nomad-Origin-Story</h2>
          <p class="mt-5 text-lg leading-relaxed text-slate-soft">
            ROCK IT UP Media ist zu 100&nbsp;% ortsunabhängig, digital und vollkommen papierlos
            aufgestellt. Der Gründer verbrachte Jahre als digitaler Nomade in den weltweit
            führenden Marketing- und KI-Tech-Bubbles — von Mexiko-City bis Bali. Aus dieser
            globalen Reise entstand eine klare Erkenntnis: Jedes Business leidet unter
            überteuertem, wirkungslosem Agentur-Marketing.
          </p>
          <p class="mt-4 text-lg leading-relaxed text-slate-soft">
            Die Vision daraus: Unternehmen von Agenturen zu befreien und ihnen eine eigene
            Inhouse-KI-Marketingabteilung einzubauen — ein System, das sie besitzen, nicht mieten.
          </p>
        </div>

        <div class="rounded-3xl border border-slate/8 bg-cloud p-8 sm:p-10">
          <span class="badge border-miami/20 bg-miami/8 text-miami-dark">Human-in-the-Loop</span>
          <h2 class="mt-4 font-display text-2xl font-bold text-slate md:text-3xl">Führung &amp; Senior-Expertise</h2>
          <p class="mt-5 text-lg leading-relaxed text-slate-soft">
            An der Spitze steht der CEO als Senior Strategist. Seine jahrzehntelange Erfahrung im
            klassischen Marketing, Corporate Design und der Führung strategischer Kommunikation
            unter Extrembedingungen — darunter jahrelange Verantwortung in der
            Krisenkommunikation im Hilfswesen — bildet das Fundament des gesamten Systems.
          </p>
          <p class="mt-4 text-lg leading-relaxed text-slate-soft">
            Er prüft jede Strategie, jede Kampagne und jede Kernaussage, bevor sie Ihr Unternehmen
            repräsentiert.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden border-t border-slate/8 bg-slate py-24 text-white">
    <div class="glow-orb -top-32 left-1/4 h-96 w-96 bg-miami/15"></div>
    <div class="glow-orb bottom-0 right-0 h-80 w-80 bg-coral/10"></div>

    <div class="container-rock relative">
      <div class="mx-auto max-w-2xl text-center">
        <span class="badge border-white/15 bg-white/5 text-white/70">Das New Yorker Agentur-Team</span>
        <h2 class="mt-5 font-display text-3xl font-bold leading-tight md:text-4xl">
          {totalAgentCount} AI-Agents, intern gespiegelt
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-white/60">
          Sieben Führungs-Agents orchestrieren {microSpecialistCount} weitere Micro-Spezialisten —
          jeder mit eigener Rolle, eigenem Charakter und klarer Funktion.
        </p>
      </div>

      <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          leadershipAgents.map((agent) => (
            <div class="rounded-3xl border border-white/10 bg-white/[0.03] p-7">
              <div class:list={["mb-4 inline-flex h-12 w-12 items-center justify-center rounded-full border font-display text-base font-bold", colorMap[agent.color]]}>
                {agent.name.charAt(0)}
              </div>
              <h3 class="font-display text-lg font-semibold text-white">{agent.name}</h3>
              <p class="mt-0.5 font-mono text-[11px] uppercase tracking-wide text-white/40">{agent.role}</p>
              <p class="mt-3 text-sm font-medium text-miami">{agent.trait}</p>
              <p class="mt-2 text-sm leading-relaxed text-white/55">{agent.bio}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-24">
    <div class="container-rock">
      <div class="mx-auto max-w-3xl rounded-3xl border border-slate/8 bg-cloud p-10 text-center">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-miami/10 text-miami-dark">
          <Icon name="shield-check" size={26} />
        </div>
        <h2 class="mt-5 font-display text-2xl font-bold text-slate">Garantien &amp; Service-Versprechen</h2>
        <ul class="mx-auto mt-6 max-w-xl space-y-3 text-left">
          {
            [
              "100 % Datensouveränität & DSGVO-Konformität auf EU-vServer-Architekturen",
              "Keine Verwendung von Kundendaten zum Training öffentlicher KI-Modelle",
              "Exklusivitäts-Garantie: max. 2–3 Neukunden-Setups pro Monat",
              "Asset-Kapitalisierung: Sie besitzen ein nachhaltiges, bilanzierbares Inhouse-Asset",
            ].map((g) => (
              <li class="flex items-start gap-3 text-slate-soft">
                <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-miami/15 text-miami-dark">
                  <Icon name="check" size={11} />
                </span>
                {g}
              </li>
            ))
          }
        </ul>
        <a href="/kontakt" class="btn-primary mt-8 inline-flex">
          Blueprint-Termin anfragen
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </section>
</Layout>
