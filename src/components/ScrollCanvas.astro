---
// Scroll-scrubbed "flight" hero: a pre-rendered sequence of warm narrative
// stills (idea → collaboration → stage moment), crossfaded into one strip of
// frames at build time (scripts/build-hero-flight.sh), then scrubbed here by
// scroll position — the same technique behind Apple's scroll-through product
// pages: scroll only ever drives time, never triggers a transition on its own.
// A continuous scroll-linked zoom + slight 3D tilt is layered on top at
// draw-time for camera-like depth, and the same grayscale+color duotone the
// rest of the site uses on photography (see .photo-duotone) is applied here
// via canvas compositing so the hero reads as part of one visual system.
import heroFrames from "../data/hero-frames.json";

interface Props {
  heightVh?: number;
}

const { heightVh = 220 } = Astro.props;
const { frameCount, pattern } = heroFrames;
---

<section class="relative bg-slate" style={`height: ${heightVh}vh`} data-hero-scroll>
  <div class="sticky top-0 h-screen w-full overflow-hidden" style="perspective: 1200px;">
    <div class="glow-orb -top-20 -left-20 h-[32rem] w-[32rem] bg-miami/25 animate-float-slow"></div>
    <div class="glow-orb bottom-0 right-0 h-96 w-96 bg-coral/20 animate-float"></div>
    <div class="glow-orb top-1/3 right-1/4 h-72 w-72 bg-sunshine/15 animate-float-slow"></div>

    <canvas id="hero-canvas" class="absolute inset-0 h-full w-full" aria-hidden="true" style="transform-origin: 50% 30%;"></canvas>
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate via-slate/35 to-slate/10"></div>
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-slate/60 via-transparent to-transparent"></div>

    <div class="relative z-10 h-full">
      <slot />
    </div>
  </div>
</section>

<script is:inline define:vars={{ frameCount, pattern }}>
  (function () {
    const outer = document.querySelector("[data-hero-scroll]");
    const canvas = document.getElementById("hero-canvas");
    const ctx = canvas.getContext("2d");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const images = new Array(frameCount);
    const frameSrc = (i) => pattern.replace("%03d", String(i + 1).padStart(3, "0"));
    let loadedCount = 0;
    for (let i = 0; i < frameCount; i++) {
      const img = new Image();
      img.decoding = "async";
      img.onload = () => {
        loadedCount++;
        if (i === 0) drawFrame(0, 0);
      };
      img.src = frameSrc(i);
      images[i] = img;
    }

    function resizeCanvas() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(window.innerWidth * dpr);
      canvas.height = Math.round(window.innerHeight * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    // Same duotone recipe as .photo-duotone (grayscale + contrast, then a
    // miami→coral gradient composited with the "color" blend mode) so the
    // scroll sequence matches every other photo on the site.
    function applyDuotone(canvasW, canvasH) {
      ctx.save();
      ctx.globalCompositeOperation = "color";
      const grad = ctx.createLinearGradient(0, 0, canvasW, canvasH);
      grad.addColorStop(0, "rgba(84, 195, 234, 0.6)");
      grad.addColorStop(1, "rgba(255, 90, 54, 0.4)");
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, canvasW, canvasH);
      ctx.restore();
    }

    function drawFrame(index, progress) {
      const img = images[Math.min(frameCount - 1, Math.max(0, index))];
      if (!img || !img.complete || img.naturalWidth === 0) return;
      const canvasW = window.innerWidth;
      const canvasH = window.innerHeight;
      const imgRatio = img.naturalWidth / img.naturalHeight;
      const canvasRatio = canvasW / canvasH;
      let drawW, drawH, offsetX, offsetY;
      if (imgRatio > canvasRatio) {
        drawH = canvasH;
        drawW = drawH * imgRatio;
        offsetX = (canvasW - drawW) / 2;
        offsetY = 0;
      } else {
        drawW = canvasW;
        drawH = drawW / imgRatio;
        offsetX = 0;
        offsetY = (canvasH - drawH) / 2;
      }
      ctx.clearRect(0, 0, canvasW, canvasH);
      ctx.filter = "grayscale(0.85) contrast(1.1) brightness(1.02)";
      ctx.drawImage(img, offsetX, offsetY, drawW, drawH);
      ctx.filter = "none";
      applyDuotone(canvasW, canvasH);

      if (!reduceMotion) {
        const scale = 1 + progress * 0.14;
        const tiltDeg = progress * 3.5;
        canvas.style.transform = `scale(${scale}) perspective(1200px) rotateX(${tiltDeg}deg)`;
      }
    }

    let currentFrame = -1;

    function computeProgress() {
      const scrollableHeight = outer.offsetHeight - window.innerHeight;
      const rectTop = outer.getBoundingClientRect().top;
      return scrollableHeight > 0 ? Math.min(1, Math.max(0, -rectTop / scrollableHeight)) : 0;
    }

    let ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const progress = computeProgress();
        const frameIndex = Math.round(progress * (frameCount - 1));
        if (frameIndex !== currentFrame) {
          currentFrame = frameIndex;
          drawFrame(currentFrame, progress);
        } else if (!reduceMotion) {
          drawFrame(currentFrame, progress);
        }
        ticking = false;
      });
    }

    if (!reduceMotion) {
      window.addEventListener("scroll", onScroll, { passive: true });
    }
    window.addEventListener("resize", () => {
      resizeCanvas();
      drawFrame(Math.max(0, currentFrame), computeProgress());
    });

    resizeCanvas();
    if (images[0].complete) {
      drawFrame(0, 0);
    }
  })();
</script>

<style>
  @media (prefers-reduced-motion: reduce) {
    [data-hero-scroll] {
      height: 100vh !important;
    }
  }
</style>
