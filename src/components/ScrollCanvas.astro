---
import heroFrames from "../data/hero-frames.json";

interface Props {
  heightVh?: number;
}

const { heightVh = 260 } = Astro.props;
const { frameCount, pattern } = heroFrames;
---

<section class="relative bg-white" style={`height: ${heightVh}vh`} data-hero-scroll>
  <div class="sticky top-0 h-screen w-full overflow-hidden bg-white">
    <canvas id="hero-canvas" class="absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-white/5 via-transparent to-white/50"></div>
    <div class="relative z-10 h-full">
      <slot />
    </div>
  </div>
</section>

<script is:inline define:vars={{ frameCount, pattern }}>
  const outer = document.querySelector("[data-hero-scroll]");
  const canvas = document.getElementById("hero-canvas");
  const ctx = canvas.getContext("2d");

  const images = new Array(frameCount);
  const frameSrc = (i) => pattern.replace("%03d", String(i + 1).padStart(3, "0"));
  for (let i = 0; i < frameCount; i++) {
    const img = new Image();
    img.decoding = "async";
    img.loading = i < 3 ? "eager" : "lazy";
    img.src = frameSrc(i);
    images[i] = img;
  }

  function resizeCanvas() {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = Math.round(window.innerWidth * dpr);
    canvas.height = Math.round(window.innerHeight * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function drawFrame(index) {
    const img = images[Math.min(frameCount - 1, Math.max(0, index))];
    if (!img || !img.complete || img.naturalWidth === 0) return;
    const canvasW = window.innerWidth;
    const canvasH = window.innerHeight;
    const imgRatio = img.naturalWidth / img.naturalHeight;
    const canvasRatio = canvasW / canvasH;
    let drawW, drawH, offsetX, offsetY;
    if (imgRatio > canvasRatio) {
      drawH = canvasH;
      drawW = drawH * imgRatio;
      offsetX = (canvasW - drawW) / 2;
      offsetY = 0;
    } else {
      drawW = canvasW;
      drawH = drawW / imgRatio;
      offsetX = 0;
      offsetY = (canvasH - drawH) / 2;
    }
    ctx.clearRect(0, 0, canvasW, canvasH);
    ctx.drawImage(img, offsetX, offsetY, drawW, drawH);
  }

  let currentFrame = 0;
  let ticking = false;

  function computeFrameIndex() {
    const scrollableHeight = outer.offsetHeight - window.innerHeight;
    const rectTop = outer.getBoundingClientRect().top;
    const progress = scrollableHeight > 0 ? Math.min(1, Math.max(0, -rectTop / scrollableHeight)) : 0;
    return Math.round(progress * (frameCount - 1));
  }

  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      const frameIndex = computeFrameIndex();
      if (frameIndex !== currentFrame) {
        currentFrame = frameIndex;
        drawFrame(currentFrame);
      }
      ticking = false;
    });
  }

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduceMotion) {
    window.addEventListener("scroll", onScroll, { passive: true });
  }
  window.addEventListener("resize", () => {
    resizeCanvas();
    drawFrame(currentFrame);
  });

  resizeCanvas();
  if (images[0].complete) {
    drawFrame(0);
  } else {
    images[0].addEventListener("load", () => drawFrame(0), { once: true });
  }
</script>

<style>
  @media (prefers-reduced-motion: reduce) {
    [data-hero-scroll] {
      height: 100vh !important;
    }
  }
</style>
