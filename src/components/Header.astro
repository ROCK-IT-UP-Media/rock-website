---
import { mainNav } from "../data/nav";
---

<header class="sticky top-0 z-50 border-b border-slate/8 bg-paper/85 backdrop-blur-lg">
  <div class="container-rock flex h-20 items-center justify-between">
    <a href="/" class="flex items-center gap-2.5 shrink-0">
      <img src="/logo-icon.png" alt="ROCK IT UP Media" class="h-9 w-9" />
      <span class="font-display text-lg font-bold tracking-tight text-slate">
        ROCK IT UP<span class="text-miami-dark"> Media</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex">
      {
        mainNav.map((item) => (
          <div class="group relative">
            <a
              href={item.href}
              data-nav-link={item.href}
              class="flex items-center gap-1 rounded-full px-4 py-2 font-display text-sm font-medium text-slate transition-colors hover:text-miami-dark"
            >
              {item.label}
              {item.children && (
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" class="mt-0.5 opacity-50">
                  <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
            </a>
            {item.children && (
              <div class="invisible absolute left-1/2 top-full w-72 -translate-x-1/2 pt-3 opacity-0 transition-all duration-200 group-hover:visible group-hover:opacity-100">
                <div class="grid gap-0.5 rounded-2xl border border-slate/8 bg-paper p-2 shadow-card-lg">
                  {item.children.map((child) => (
                    <a href={child.href} class="rounded-xl px-3.5 py-2.5 font-body text-sm text-slate-soft transition-colors hover:bg-cloud hover:text-miami-dark">
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a href="/kontakt" data-magnetic data-magnetic-strength="0.35" class="btn-primary hidden lg:inline-flex">
        Blueprint buchen
      </a>
      <button id="menu-toggle" aria-label="Menü öffnen" class="grid h-11 w-11 place-items-center rounded-full border border-slate/10 lg:hidden">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-slate/8 bg-paper lg:hidden">
    <div class="container-rock flex flex-col gap-1 py-4">
      {
        mainNav.map((item) => (
          <a href={item.href} class="rounded-xl px-3 py-2.5 font-display text-sm font-medium text-slate">
            {item.label}
          </a>
        ))
      }
      <a href="/kontakt" class="btn-primary mt-2 justify-center">
        Blueprint buchen
      </a>
    </div>
  </div>
</header>

