---
import { modules } from "../data/modules";

const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden border-t border-slate/8 bg-slate text-white">
  <div class="glow-orb -bottom-40 -right-40 h-96 w-96 bg-miami/20"></div>
  <div class="container-rock relative py-16">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-1">
        <a href="/" class="mb-4 flex items-center gap-2.5">
          <img src="/logo-icon.png" alt="ROCK IT UP Media" class="h-9 w-9" />
          <span class="font-display text-lg font-bold">ROCK IT UP Media</span>
        </a>
        <p class="max-w-xs text-sm leading-relaxed text-white/60">
          Ihre KI-Marketingabteilung. Schlüsselfertig. Autark. Marktdominant.
        </p>
        <div class="mt-6 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3.5 py-1.5 font-mono text-xs text-white/70">
          <span class="h-1.5 w-1.5 rounded-full bg-miami"></span>
          Human Guided Strategy &amp; Quality Assurance
        </div>
      </div>

      <div>
        <h3 class="mb-4 font-display text-sm font-semibold uppercase tracking-wider text-white/40">Module</h3>
        <ul class="space-y-2.5">
          {
            modules.map((m) => (
              <li>
                <a href={`/leistungen/${m.slug}`} class="text-sm text-white/70 transition-colors hover:text-miami">
                  {m.shortTitle}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="mb-4 font-display text-sm font-semibold uppercase tracking-wider text-white/40">Unternehmen</h3>
        <ul class="space-y-2.5">
          <li><a href="/ueber-uns" class="text-sm text-white/70 transition-colors hover:text-miami">Über Uns</a></li>
          <li><a href="/leistungen" class="text-sm text-white/70 transition-colors hover:text-miami">Leistungen</a></li>
          <li><a href="/kontakt" class="text-sm text-white/70 transition-colors hover:text-miami">Blueprint buchen</a></li>
        </ul>
      </div>

      <div>
        <h3 class="mb-4 font-display text-sm font-semibold uppercase tracking-wider text-white/40">Kontakt</h3>
        <ul class="space-y-2.5 text-sm text-white/70">
          <li>
            <a href="mailto:christoph@rockitup.media" class="transition-colors hover:text-miami">christoph@rockitup.media</a>
          </li>
          <li class="text-white/40">100 % Digital &amp; Ortsunabhängig</li>
          <li class="text-white/40">EU-vServer · DSGVO-konform</li>
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-8 text-xs text-white/40 md:flex-row">
      <p>&copy; {year} ROCK IT UP Media. Alle Rechte vorbehalten.</p>
      <p class="font-mono">1 Senior Strategist · 162 AI-Agents</p>
    </div>
  </div>
</footer>
