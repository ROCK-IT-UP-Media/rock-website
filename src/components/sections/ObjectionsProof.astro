---
import Icon from "../ui/Icon.astro";

const objections = [
  {
    icon: "shield-check" as const,
    concern: "„Wie steht es um Datenschutz & DSGVO?“",
    answer:
      "Betrieb ausschließlich auf EU-vServer-Architekturen in geschlossenen Workspaces. Keine Verwendung Ihrer Daten zum Training öffentlicher KI-Modelle.",
  },
  {
    icon: "fingerprint" as const,
    concern: "„Erzeugt KI nicht nur austauschbaren Einheitsbrei?“",
    answer:
      "Ihre echte Brand DNA wird codiert, nicht generisch simuliert. Jede Ausgabe durchläuft die menschliche Qualitätskontrolle des Senior-Strategen.",
  },
  {
    icon: "target" as const,
    concern: "„Ist die Initialinvestition nicht zu hoch?“",
    answer:
      "Sie amortisiert sich schnell im Vergleich zu klassischen Agentur-Retainern oder einer Vollzeit-Personalaufstockung — und Sie besitzen ein bilanzierbares Asset.",
  },
];
---

<section class="border-t border-slate/8 bg-cloud py-24">
  <div class="container-rock">
    <div class="mx-auto max-w-2xl text-center">
      <span class="section-eyebrow">Häufige Fragen</span>
      <h2 class="mt-5 font-display text-3xl font-bold leading-tight text-slate md:text-4xl">
        Was Entscheider uns zuerst fragen
      </h2>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {
        objections.map((o) => (
          <div class="card bg-white">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-slate/6 text-slate">
              <Icon name={o.icon} size={22} />
            </div>
            <h3 class="mt-5 font-display text-base font-semibold text-slate">{o.concern}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-soft">{o.answer}</p>
          </div>
        ))
      }
    </div>

    <div class="mx-auto mt-14 flex max-w-3xl flex-col items-center gap-6 rounded-3xl border border-slate/8 bg-white p-10 text-center sm:flex-row sm:text-left">
      <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-miami/10 text-miami-dark">
        <Icon name="zap" size={28} />
      </div>
      <p class="font-display text-lg italic leading-snug text-slate">
        „Wenn ROCK IT UP Media die Bühne betritt, geht das Licht an, der erste Akkord dröhnt durch
        die Halle — und die Energie katapultiert augenblicklich durch die Decke.“
      </p>
    </div>
  </div>
</section>
