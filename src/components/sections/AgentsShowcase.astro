---
import { leadershipAgents, totalAgentCount, microSpecialistCount, ceo } from "../../data/agents";
import Icon from "../ui/Icon.astro";

const accents = ["miami", "coral", "sunshine"] as const;
const accentClasses: Record<(typeof accents)[number], string> = {
  miami: "hover:border-miami/40",
  coral: "hover:border-coral/40",
  sunshine: "hover:border-sunshine/40",
};
const dotClasses: Record<(typeof accents)[number], string> = {
  miami: "bg-miami",
  coral: "bg-coral",
  sunshine: "bg-sunshine",
};
---

<section class="relative overflow-hidden border-t border-slate/8 bg-slate py-24 text-white">
  <div class="photo-duotone absolute inset-0">
    <img
      src="/assets/pages/agents-network.jpg"
      alt=""
      class="h-full w-full object-cover opacity-40"
      data-parallax
      data-parallax-strength="0.08"
    />
  </div>
  <div class="absolute inset-0 bg-slate/50"></div>
  <div class="glow-orb -top-32 left-1/4 h-96 w-96 bg-miami/20"></div>
  <div class="glow-orb bottom-0 right-0 h-80 w-80 bg-coral/10"></div>
  <div class="glow-orb top-1/3 right-1/4 h-56 w-56 bg-sunshine/10"></div>

  <div class="container-rock relative">
    <div class="mx-auto max-w-2xl text-center">
      <span class="badge border-miami/30 bg-miami/15 text-miami">Das Team</span>
      <h2 class="mt-5 font-display text-3xl font-bold leading-tight md:text-4xl">
        Ihr New Yorker Agentur-Team.
        <span class="text-miami"> Gespiegelt in {totalAgentCount} AI-Agents.</span>
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-white/60">
        Jeder Agent hat einen Namen, eine Persona und eine feste Aufgabe: {leadershipAgents.length}{" "}
        Köpfe an der Spitze, {microSpecialistCount} weitere im Hintergrund — ein Senior-Stratege
        ganz oben, der alles zusammenhält.
      </p>
    </div>

    <div class="mx-auto mt-14 flex max-w-2xl items-center gap-6 rounded-3xl border border-miami/25 bg-gradient-to-br from-miami/15 to-transparent p-7">
      <div class="flex h-20 w-20 shrink-0 items-center justify-center rounded-full border-2 border-miami bg-slate font-display text-2xl font-bold text-miami">
        CB
      </div>
      <div>
        <span class="badge border-miami/30 bg-miami/10 text-miami">{ceo.role}</span>
        <h3 class="mt-2 font-display text-xl font-semibold text-white">{ceo.name}</h3>
        <p class="mt-1 text-sm leading-relaxed text-white/60">{ceo.trait} — führt Strategie, Qualitätskontrolle und jede Kundenbeziehung persönlich.</p>
      </div>
    </div>

    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        leadershipAgents.map((agent, i) => {
          const accent = accents[i % accents.length];
          return (
            <div class:list={["spotlight-card group overflow-hidden rounded-3xl border border-white/10 bg-white/[0.04] transition-colors hover:bg-white/[0.07]", accentClasses[accent]]} data-reveal style={`--reveal-i:${i}`}>
              <div class="photo-duotone relative h-44 overflow-hidden">
                <img src={agent.photo} alt={agent.name} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" />
                <div class="absolute inset-0 bg-gradient-to-t from-slate via-slate/10 to-transparent" />
              </div>
              <div class="p-5">
                <div class="flex items-center gap-2">
                  <span class:list={["h-1.5 w-1.5 rounded-full", dotClasses[accent]]} />
                  <p class="font-display text-[11px] font-medium text-white/45">{agent.role}</p>
                </div>
                <h3 class="mt-2 font-display text-base font-semibold text-white">{agent.name}</h3>
                <p class="mt-2 text-sm font-medium text-miami">{agent.trait}</p>
                <p class="mt-2 text-sm leading-relaxed text-white/55">{agent.bio}</p>
              </div>
            </div>
          );
        })
      }
    </div>

    <div class="mt-10 flex items-center justify-center gap-3 rounded-full border border-white/10 bg-white/5 px-6 py-3 text-center font-mono text-xs text-white/50 sm:w-fit sm:mx-auto">
      <Icon name="users" size={14} />
      + {microSpecialistCount} weitere Micro-Spezialisten im Hintergrund im Einsatz
    </div>
  </div>
</section>
