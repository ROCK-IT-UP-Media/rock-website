---
import { leadershipAgents, totalAgentCount, microSpecialistCount } from "../../data/agents";

const colorMap: Record<string, string> = {
  miami: "bg-miami/12 text-miami-dark border-miami/20",
  coral: "bg-coral/10 text-coral-dark border-coral/20",
  cyan: "bg-cyan/10 text-slate border-cyan/25",
  slate: "bg-slate/6 text-slate border-slate/15",
};
---

<section class="relative overflow-hidden border-t border-slate/8 bg-slate py-24 text-white">
  <img
    src="/assets/pages/agents-network.jpg"
    alt=""
    class="absolute inset-0 h-full w-full object-cover opacity-50"
    data-parallax
    data-parallax-strength="0.08"
  />
  <div class="absolute inset-0 bg-slate/40"></div>
  <div class="glow-orb -top-32 left-1/4 h-96 w-96 bg-miami/15"></div>
  <div class="glow-orb bottom-0 right-0 h-80 w-80 bg-coral/10"></div>

  <div class="container-rock relative">
    <div class="mx-auto max-w-2xl text-center">
      <span class="badge border-white/15 bg-white/5 text-white/70">Das Team</span>
      <h2 class="mt-5 font-display text-3xl font-bold leading-tight md:text-4xl">
        Ihr New Yorker Agentur-Team.
        <span class="text-miami"> Gespiegelt in {totalAgentCount} AI-Agents.</span>
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-white/60">
        {leadershipAgents.length} Führungs-Agents orchestrieren {microSpecialistCount} weitere
        Micro-Spezialisten — geleitet von einem menschlichen Senior-Strategen.
      </p>
    </div>

    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        leadershipAgents.map((agent, i) => (
          <div class="spotlight-card rounded-3xl border border-white/10 bg-white/[0.03] p-6 transition-colors hover:bg-white/[0.06]" data-reveal style={`--reveal-i:${i}`}>
            <div class:list={["mb-4 inline-flex h-11 w-11 items-center justify-center rounded-full border font-display text-sm font-bold", colorMap[agent.color]]}>
              {agent.name.charAt(0)}
            </div>
            <h3 class="font-display text-base font-semibold text-white">{agent.name}</h3>
            <p class="mt-0.5 font-mono text-[11px] uppercase tracking-wide text-white/40">{agent.role}</p>
            <p class="mt-3 text-sm font-medium text-miami">{agent.trait}</p>
            <p class="mt-2 text-sm leading-relaxed text-white/55">{agent.bio}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-10 flex items-center justify-center gap-3 rounded-full border border-white/10 bg-white/5 px-6 py-3 text-center font-mono text-xs text-white/50 sm:w-fit sm:mx-auto">
      + {microSpecialistCount} weitere Micro-Spezialisten im Hintergrund im Einsatz
    </div>
  </div>
</section>
