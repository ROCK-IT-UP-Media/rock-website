---
import Icon from "../ui/Icon.astro";

const pillars = [
  {
    icon: "users" as const,
    title: "Human-in-the-Loop",
    text: "Ein krisenerprobter Senior-Stratege mit jahrzehntelanger Marketing-Expertise behält Führung, Strategie und Qualitätskontrolle.",
    accent: "miami" as const,
  },
  {
    icon: "zap" as const,
    title: "162 AI-Agents Powerhouse",
    text: "Blitzschnelle, hochspezialisierte operative Umsetzung — von Copy bis Code, rund um die Uhr einsatzbereit.",
    accent: "coral" as const,
  },
  {
    icon: "globe" as const,
    title: "100 % Ortsunabhängig",
    text: "Digital, papierlos, weltweit einsatzbereit — mit globalem Experten-Backup-Netzwerk als Human-Safety-Net.",
    accent: "sunshine" as const,
  },
  {
    icon: "shield-check" as const,
    title: "Datensouveränität & DSGVO",
    text: "Schlüsselfertige Inhouse-Architekturen auf EU-vServern statt unkontrollierter Datenweitergabe an offene US-Modelle.",
    accent: "miami" as const,
  },
];

const iconStyles: Record<"miami" | "coral" | "sunshine", string> = {
  miami: "bg-miami/12 text-miami-dark",
  coral: "bg-coral/12 text-coral-dark",
  sunshine: "bg-sunshine/18 text-sunshine-dark",
};
---

<section class="py-24">
  <div class="container-rock">
    <div class="mx-auto max-w-2xl text-center">
      <span class="section-eyebrow">Das Fundament</span>
      <h2 class="mt-5 font-display text-3xl font-bold leading-tight text-slate md:text-4xl">
        Vier Säulen, die den Unterschied machen
      </h2>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        pillars.map((p, i) => (
          <div class="spotlight-card card" data-reveal style={`--reveal-i:${i}`}>
            <div class:list={["flex h-12 w-12 items-center justify-center rounded-2xl", iconStyles[p.accent]]}>
              <Icon name={p.icon} size={22} />
            </div>
            <h3 class="mt-5 font-display text-lg font-semibold text-slate">{p.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-slate-soft">{p.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
